# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/threat_intelligence

# Optional: increases the NVD API request quota.
# NVD_API_KEY=your_nvd_api_key

# Optional and PAID: enables real Claude-generated analysis
# (services/llm_service.py). The Anthropic API bills per token, unlike every
# other piece of this project. Leave both lines below unset/false to keep
# this project entirely free — no key is required to run the app or its
# test suite; the deterministic rules-based analyser in services/ai_service.py
# is used instead. Real Claude calls only ever happen if BOTH lines are set.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_MODEL=claude-opus-5
# ENABLE_LLM_ANALYSIS=false
