# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/threat_intelligence

# Optional: increases the NVD API request quota.
# NVD_API_KEY=your_nvd_api_key

# Optional: enables real LLM-generated analysis via Groq
# (services/llm_service.py). Groq's free developer tier has no credit
# system and no per-token charge - just rate limits - so this stays free.
# Leave both lines below unset/false to skip it entirely; no key is
# required to run the app or its test suite. Model catalogue shifts over
# time — check https://console.groq.com/docs/models for current IDs.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=qwen/qwen3.6-27b
# ENABLE_LLM_ANALYSIS=false
