# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/threat_intelligence

# Optional: increases the NVD API request quota.
# NVD_API_KEY=your_nvd_api_key

# Optional: enables real Claude-generated analysis (services/llm_service.py).
# Unset (or ENABLE_LLM_ANALYSIS=false) falls back to the deterministic
# rules-based analyser in services/ai_service.py — no key required to run
# the app or its test suite.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# LLM_MODEL=claude-opus-5
# ENABLE_LLM_ANALYSIS=true
