# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/threat_intelligence

# Optional: increases the NVD API request quota.
# NVD_API_KEY=your_nvd_api_key

# Optional: enables real LLM-generated analysis via Google's Gemini API
# (services/llm_service.py). Google AI Studio's free tier (no credit card)
# uses per-minute/per-day rate limits, not a metered credit pool, so this
# stays free. Leave both lines below unset/false to skip it entirely; no
# key is required to run the app or its test suite. Get a free key at
# https://aistudio.google.com/app/apikey — model catalogue shifts over
# time, check https://ai.google.dev/gemini-api/docs/models for current IDs.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# ENABLE_LLM_ANALYSIS=false
